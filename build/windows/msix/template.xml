<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="watools"
        Arguments=""
        InstallLocation="C:\Program Files\wangle201210\waTools">
    </Installer>
    <PackageInformation
        PackageName="waTools"
        PackageDisplayName="waTools"
        PublisherName="CN=wangle201210"
        PublisherDisplayName="wangle201210"
        Version="0.1.0.0"
        PackageDescription="waTools 桌面工具集">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.wangle201210.watools"
                Description="waTools 桌面工具集"
                DisplayName="waTools"
                ExecutableName="watools"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>waTools</DisplayName>
            <PublisherDisplayName>wangle201210</PublisherDisplayName>
            <Description>waTools 桌面工具集</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="watools.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
